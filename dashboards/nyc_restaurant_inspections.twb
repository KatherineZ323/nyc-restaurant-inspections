            <column caption='A threshold' datatype='real' name='[Parameter 4931029299978244]' param-domain-type='any' role='measure' type='quantitative' value='13.5'>
              <calculation class='tableau' formula='13.5' />
            </column>
            <column caption='B/C threshold' datatype='real' name='[Parameter 4931029300256773]' param-domain-type='any' role='measure' type='quantitative' value='27.5'>
              <calculation class='tableau' formula='27.5' />
